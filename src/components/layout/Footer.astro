---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted/30" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
      <p>&copy; {year} SafeTools.dev. Your data never leaves your browser.</p>
      <nav class="flex items-center gap-4" aria-label="Footer navigation">
        <a href="/privacy" class="hover:text-foreground transition-colors">Privacy</a>
        <a href="https://github.com/youichi-uda/safetools" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors">GitHub</a>
      </nav>
    </div>
  </div>
</footer>
