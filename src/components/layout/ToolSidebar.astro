---
import { tools, categories } from '@/lib/tools-registry';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
---

<aside class="hidden lg:block w-56 shrink-0 border-r border-border p-4 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto" aria-label="Tool navigation">
  <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Tools</h2>
  {categories.map((category) => (
    <div class="mb-4">
      <h3 class="text-xs font-medium text-muted-foreground mb-1">{category}</h3>
      <ul class="space-y-0.5">
        {tools
          .filter((t) => t.category === category)
          .map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}`}
                class:list={[
                  'block px-2 py-1.5 rounded-md text-sm transition-colors',
                  currentSlug === tool.slug
                    ? 'bg-accent text-accent-foreground font-medium'
                    : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground',
                ]}
              >
                <span class="font-mono text-xs mr-1.5">{tool.icon}</span>
                {tool.shortName}
              </a>
            </li>
          ))}
      </ul>
    </div>
  ))}
</aside>
