---
import ThemeToggle from '@/components/shared/ThemeToggle';
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-sm">
  <div class="mx-auto max-w-7xl flex items-center justify-between px-4 h-14">
    <a href="/" class="flex items-center gap-2 font-bold text-lg">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-safe text-safe-foreground text-sm font-mono font-bold">ST</span>
      <span>SafeTools<span class="text-muted-foreground">.dev</span></span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm">
      <a href="/tools/json-formatter" class="text-muted-foreground hover:text-foreground transition-colors">Tools</a>
      <a href="/privacy" class="text-muted-foreground hover:text-foreground transition-colors">Privacy</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">GitHub</a>
    </nav>
    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
    </div>
  </div>
</header>
