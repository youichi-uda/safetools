---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import CodeBeautifier from '@/components/tools/code-beautifier/CodeBeautifier';

const tool = getToolBySlug('code-beautifier')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
    ogImage: `https://safetools.dev/og/${tool.slug}.svg`,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <CodeBeautifier client:load />
</ToolLayout>
