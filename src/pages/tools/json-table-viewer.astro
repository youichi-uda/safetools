---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import JsonTableViewer from '@/components/tools/json-table-viewer/JsonTableViewer';

const tool = getToolBySlug('json-table-viewer')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
    ogImage: `https://safetools.dev/og/${tool.slug}.png`,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <JsonTableViewer client:load />

  <section class="mt-16 pt-8 border-t border-border prose prose-sm dark:prose-invert max-w-none">
    <h2 class="text-xl font-bold mb-4">What is JSON Table Viewer?</h2>
    <p class="text-muted-foreground mb-4">JSON Table Viewer transforms JSON arrays into interactive, sortable tables. Filter data, paginate through large datasets, and export to CSV — all in your browser.</p>

    <h2 class="text-xl font-bold mb-4">How to Use</h2>
    <ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
      <li>Paste a JSON array into the editor</li>
      <li>Click column headers to sort ascending/descending</li>
      <li>Use the search box to filter rows</li>
      <li>Export the table as CSV</li>
    </ol>

    <h2 class="text-xl font-bold mb-4">Privacy & Security</h2>
    <p class="text-muted-foreground">All processing happens entirely in your browser. No data is sent to any server.</p>
  </section>
</ToolLayout>
