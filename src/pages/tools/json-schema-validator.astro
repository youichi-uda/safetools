---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import JsonSchemaValidator from '@/components/tools/json-schema-validator/JsonSchemaValidator';

const tool = getToolBySlug('json-schema-validator')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
    ogImage: `https://safetools.dev/og/${tool.slug}.png`,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <JsonSchemaValidator client:load />

  <section class="mt-16 pt-8 border-t border-border prose prose-sm dark:prose-invert max-w-none">
    <h2 class="text-xl font-bold mb-4">What is JSON Schema Validator?</h2>
    <p class="text-muted-foreground mb-4">JSON Schema Validator checks your JSON data against a JSON Schema definition with detailed error reporting. Supports JSON Schema Draft 7 and Draft 2020-12 with all validation keywords.</p>

    <h2 class="text-xl font-bold mb-4">How to Use</h2>
    <ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
      <li>Enter or paste a JSON Schema in the left editor</li>
      <li>Enter the JSON data to validate in the right editor</li>
      <li>Select the schema draft version</li>
      <li>Review validation results and click errors to see JSON paths</li>
    </ol>

    <h2 class="text-xl font-bold mb-4">Privacy & Security</h2>
    <p class="text-muted-foreground">All processing happens entirely in your browser. No data is sent to any server.</p>
  </section>
</ToolLayout>
