---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import SensitiveDataRedactor from '@/components/tools/sensitive-data-redactor/SensitiveDataRedactor';

const tool = getToolBySlug('sensitive-data-redactor')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
    ogImage: `https://safetools.dev/og/${tool.slug}.png`,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <SensitiveDataRedactor client:load />

  <section class="mt-16 pt-8 border-t border-border prose prose-sm dark:prose-invert max-w-none">
    <h2 class="text-xl font-bold mb-4">What is Sensitive Data Redactor?</h2>
    <p class="text-muted-foreground mb-4">Sensitive Data Redactor automatically detects and masks sensitive information like email addresses, phone numbers, SSNs, credit card numbers, API keys, and more. Perfect for sanitizing logs, configs, and documents before sharing.</p>

    <h2 class="text-xl font-bold mb-4">How to Use</h2>
    <ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
      <li>Paste text containing sensitive data into the input area</li>
      <li>Toggle which pattern categories to detect</li>
      <li>Choose your preferred masking style</li>
      <li>Copy the redacted output</li>
    </ol>

    <h2 class="text-xl font-bold mb-4">Privacy & Security</h2>
    <p class="text-muted-foreground">All processing happens entirely in your browser. No data is sent to any server.</p>
  </section>
</ToolLayout>
