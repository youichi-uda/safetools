---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import JwtDecoder from '@/components/tools/jwt-decoder/JwtDecoder';

const tool = getToolBySlug('jwt-decoder')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <JwtDecoder client:load />
</ToolLayout>
