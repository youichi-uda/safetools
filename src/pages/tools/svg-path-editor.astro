---
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getJsonLdWebApplication } from '@/lib/seo';
import { getToolBySlug } from '@/lib/tools-registry';
import SvgPathEditor from '@/components/tools/svg-path-editor/SvgPathEditor';

const tool = getToolBySlug('svg-path-editor')!;
const jsonLd = getJsonLdWebApplication(tool);
---

<ToolLayout
  seo={{
    title: tool.metaTitle,
    description: tool.metaDescription,
    ogImage: `https://safetools.dev/og/${tool.slug}.png`,
  }}
  jsonLd={jsonLd}
  currentSlug={tool.slug}
>
  <SvgPathEditor client:load />

  <section class="mt-16 pt-8 border-t border-border prose prose-sm dark:prose-invert max-w-none">
    <h2 class="text-xl font-bold mb-4">What is SVG Path Editor?</h2>
    <p class="text-muted-foreground mb-4">SVG Path Editor lets you visually edit SVG path data with draggable control points, a live preview canvas, and bidirectional sync between the visual editor and path data string.</p>

    <h2 class="text-xl font-bold mb-4">How to Use</h2>
    <ol class="list-decimal list-inside space-y-2 text-muted-foreground mb-4">
      <li>Enter SVG path data in the text input or use the example paths</li>
      <li>Drag control points on the canvas to modify the path</li>
      <li>Adjust stroke, fill, and grid settings</li>
      <li>Copy the generated path data for use in your SVG files</li>
    </ol>

    <h2 class="text-xl font-bold mb-4">Privacy & Security</h2>
    <p class="text-muted-foreground">All processing happens entirely in your browser. No data is sent to any server.</p>
  </section>
</ToolLayout>
